# =============================================================================
# Copy this file to `.env` and fill it in.  Never commit `.env`.
# =============================================================================

# --- Option A: connect to Supabase -------------------------------------------
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API → Project API keys → `anon` / `public`
#
# This key is public by design: it ships inside the JavaScript bundle, and every
# patient's browser can read it. That is safe ONLY because row level security is
# enabled on every table (see supabase/migrations/002_rls.sql). Do not weaken
# those policies on the assumption that the key is secret.
#
# NEVER put the `service_role` key here. It bypasses RLS completely and would
# hand every patient the ability to read every other patient's record.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Option B: run with no backend at all ------------------------------------
# Set to `true` to run the whole system against an in-browser mock: no database,
# no internet, no credentials. All three interfaces work. Data lives in this
# browser only, and the UI shows a "डेमो" banner so it can never be mistaken for
# the real thing. Leave as `false` for any real deployment.
VITE_DEMO_MODE=false

# --- Server-side only (NOT read by the app; used by `npm run test:sql`) ------
# Project Settings → Database → Connection string → URI
# Supabase blocks this host from outside their network by default; add your IP
# or use the pooler. Never prefix this with VITE_ — that would bundle it into
# the browser build and expose the database password to every visitor.
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
